{
  "name": "tauri-shell",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check:versions": "python scripts/check_versions.py",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "test": "npm run test:contracts && npm run test:components",
