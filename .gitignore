/data/
/backend/data/

# Python 虚拟环境
/backend/.venv/
/.venv/
/backend/.pytest_runtime/

# 构建与发布产物
/release/
/src-tauri/gen/

# 工具运行时与本地环境
/.reasonix/
/.node_modules_cleanup_pending/
/null/
/.codex-vite.log
/.env
/.vscode/
.claude/settings.local.json

